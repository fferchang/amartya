// Copiar este archivo a config.local.h (en esta misma carpeta) y completarlo.
// config.local.h está en el .gitignore: tiene la contraseña del WiFi y la del
// broker, y no puede terminar en el repo.
#pragma once

// La red WiFi del lugar. El C3 solo habla 2,4 GHz: si el router tiene las dos
// bandas con el mismo nombre suele andar igual, pero una red solo de 5 GHz no
// la ve nunca.
#define WIFI_SSID "nombre-de-la-red"
#define WIFI_PASS "contraseña"

// El broker MQTT. Para UMA NET es un cluster de HiveMQ Cloud: puerto 8883, con
// TLS. Para probar en casa contra un Mosquitto local sin cifrar: la IP de la
// PC, puerto 1883 y MQTT_TLS en 0.
#define MQTT_HOST "xxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_TLS  1

// Usuario y contraseña del broker. Los da quien administra el broker.
#define MQTT_USER "usuario"
#define MQTT_PASS "contraseña"

// El sitio. Va en el tópico (sensores/<SITIO>/...) y es lo que identifica a
// este nodo: sin espacios, acentos ni barras. Para las pruebas UMA NET pidió
// "huergo_prueba"; el del montaje lo definen ellos.
#define SITIO "huergo_prueba"

// Calibración del tanque, en cm, medidas desde la CARA del sensor:
//   DIST_FONDO_CM: hasta el fondo (tanque vacío)
//   DIST_LLENO_CM: hasta el agua con el tanque lleno
// Con estas dos el nodo calcula el porcentaje. Son de ESTE tanque: cambiar de
// tanque es cambiarlas y volver a flashear. DIST_LLENO_CM no puede ser menor
// que 25 (la zona ciega del sensor): si lo es, no compila.
#define DIST_FONDO_CM 180.0f
#define DIST_LLENO_CM 30.0f
